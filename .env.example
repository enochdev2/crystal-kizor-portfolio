# Required before the production Vercel deployment so canonical, sitemap and
# Open Graph URLs never resolve to localhost.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Preferred enquiry delivery: Resend REST API.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be a sender/domain verified in Resend, e.g. Crystal Kizor <hello@yourdomain.com>
ENQUIRY_FROM_EMAIL=

# Optional alternative to Resend. If set, the server posts validated enquiry
# JSON to this HTTPS endpoint.
ENQUIRY_WEBHOOK_URL=
